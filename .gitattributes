# Normalize line endings for text files (LF in repo, native on checkout)
* text=auto

# Explicitly normalize common web files to LF
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf

# Binary assets must never be normalized
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
